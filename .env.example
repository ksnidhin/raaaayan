# Example .env file for Raayan configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git.

# ============================================================
# REQUIRED — bot will not start without these
# ============================================================

# Telegram app ID (from https://my.telegram.org)
APP_ID=

# Telegram app hash (from https://my.telegram.org)
APP_HASH=

# Telegram bot token (from @BotFather)
BOT_TOKEN=

# Owner Telegram user ID(s), comma-separated
OWNER=

# Database connection string (MySQL)
# Format: mysql+pymysql://USER:PASSWORD@HOST/DBNAME
# In Docker: host = mysql (service name)
DB_DSN=mysql+pymysql://raayan:changeme@mysql/raayan

# ============================================================
# REQUIRED for Docker deployment — MySQL credentials
# Must match the values used in DB_DSN above
# ============================================================

MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=raayan
MYSQL_USER=raayan
MYSQL_PASSWORD=changeme

# ============================================================
# OPTIONAL — Redis
# ============================================================

# Redis host. Leave empty to use in-process fakeredis (no persistence)
# In Docker: set to "redis" (the service name)
REDIS_HOST=redis

# ============================================================
# OPTIONAL — Feature flags
# ============================================================

# Number of Pyrogram worker threads (default: 100)
WORKERS=100

# List of authorized Telegram user IDs, comma-separated
# Leave empty to allow all users (or rely on OWNER restriction)
AUTHORIZED_USER=

# Enable FFmpeg for merging video+audio streams (True/False)
ENABLE_FFMPEG=False

# Desired audio format when downloading audio (e.g. mp3, m4a, wav)
# Leave empty to use m4a
AUDIO_FORMAT=

# Enable m3u8/HLS stream support (True/False)
M3U8_SUPPORT=False

# Enable aria2c for direct downloads (True/False)
# aria2c must be installed (included in Docker image)
ENABLE_ARIA2=False

# Path to Rclone executable (for cloud upload, optional)
RCLONE_PATH=

# ============================================================
# OPTIONAL — VIP / Payment (requires Telegram payment provider)
# ============================================================

# Enable VIP quota purchase features (True/False)
ENABLE_VIP=False

# Telegram payment provider token (from @BotFather)
PROVIDER_TOKEN=

# Free downloads allowed per user per day
FREE_DOWNLOAD=5

# Number of paid downloads per 1 USD
TOKEN_PRICE=10

# ============================================================
# ADVANCED — Change only if you know what you're doing
# ============================================================

# Path for temporary download files
# Leave empty to use the system default temp directory
TMPFILE_PATH=

# PO Token for YouTube (see https://github.com/yt-dlp/yt-dlp/wiki/PO-Token-Guide)
POTOKEN=

# Browser cookies source for yt-dlp (e.g. firefox, chrome)
BROWSERS=firefox
